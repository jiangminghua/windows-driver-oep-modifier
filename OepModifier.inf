;/*
; * File: OepModifier.inf
; * Description: Driver installation file
; * Signature: Windows Driver Installation File
; */

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
DriverVer=05/17/2026,1.0.0.0
CatalogFile=OepModifier.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksFiles]
OepModifier.sys = 1,,..\

[SourceDisksNames]
1 = %DiskName%

[DefaultInstall.NTamd64]
CopyFiles = OepModifier.CopyFiles

[OepModifier.CopyFiles]
OepModifier.sys

[DefaultInstall.NTamd64.Services]
AddService = OepModifier,0x00000002,OepModifier.ServiceInstall

[OepModifier.ServiceInstall]
DisplayName = %ServiceName%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\OepModifier.sys

[DefaultUninstall.NTamd64]
LegacyUninstall = 1
DeleteService = OepModifier
DelFiles = OepModifier.DelFiles

[OepModifier.DelFiles]
OepModifier.sys

[Strings]
ManufacturerName = "OepModifier"
DiskName = "OepModifier Installation Disk"
ServiceName = "OEP Modifier Driver"
